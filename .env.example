# ── StitchCheck environment configuration ──
# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any file containing real credentials.

# OpenRouter API key — itinerary extraction via MiniMax M3 (OpenRouter). Server-side only.
OPENROUTER_API_KEY=

# Optional extraction model override (default: minimax/minimax-m3:free)
EXTRACTION_MODEL=

# ── Atlas (flight Search and Verify) — server-side only ──
# Atlas API client ID. Never expose in browser bundle.
ATLAS_CLIENT_ID=

# Atlas API client secret. Never expose in browser bundle.
ATLAS_CLIENT_SECRET=

# Data mode: "offline" (fixture-only, default) or "live" (where supported by evidence)
DATA_MODE=offline

# ─ Nosana (decentralized GPU workload) — server-side only ──
# Nosana API key for workload submission. Never expose in browser bundle.
NOSANA_API_KEY=

# Nosana market address (Solana public key)
NOSANA_MARKET=

# Maximum USD spend ceiling for Nosana workloads (safety limit)
NOSANA_COST_CEILING_USD=10

# ── Daytona (sandbox orchestration) — server-side only ──
# Daytona API key for sandbox lifecycle management. Never expose in browser bundle.
DAYTONA_API_KEY=

# Daytona API URL (default: https://app.daytona.io/api)
DAYTONA_API_URL=

# Daytona target location (e.g. us, eu)
DAYTONA_TARGET=

# ── Demo mode ──
# Selects which orchestrator path to use: local | daytona | atlas
# local = fixture-only (default, safe for development)
# daytona = Daytona sandbox worker for Atlas read-only
# atlas = direct Atlas adapter/CLI for read-only Search/Verify
DEMO_MODE=local

# ── Atlas safety flags ──
# Allow Atlas read-only operations (Search, Verify). Default: false.
ATLAS_LIVE_READ_ONLY=false

# Allow Atlas write operations. MUST remain false unless ALL 7 ticketing
# prerequisites are confirmed. Default: false.
ATLAS_WRITES_ENABLED=false

# Enable local-only simulated ticketing UI. Requires ATLAS_WRITES_ENABLED=false.
# Default: false.
ATLAS_TICKETING_SIMULATION_ENABLED=false

# ── Daytona safety flags ──
# Allow Daytona orchestrator to create sandboxes. Default: false.
DAYTONA_ENABLED=false

# Allow Daytona risk computation. MUST remain false until a real sandbox
# lifecycle with evidence exists. Default: false.
DAYTONA_RISK_COMPUTE_ENABLED=false

# ── Nosana safety flags ──
# Allow Nosana workload submission. Default: false.
NOSANA_ENABLED=false

# Allow Nosana live job execution. Default: false.
NOSANA_LIVE_ENABLED=false

# ── Atlas Sandbox write scaffolding (fail closed) ──
# Target environment for Atlas sandbox routes. Must be exactly "sandbox".
ATLAS_ENVIRONMENT=sandbox

# Kill switch for the Atlas Sandbox write scaffold routes. Default: false.
# Write execution is NOT IMPLEMENTED and remains disabled pending contract
# approval; flipping this flag alone never enables a real write.
ATLAS_SANDBOX_WRITES_ENABLED=false

# Atlas Sandbox base URL. If set, must equal exactly
# https://sandbox.atriptech.com/ or all sandbox routes fail closed.
ATLAS_SANDBOX_BASE_URL=https://sandbox.atriptech.com/
