# ── StitchCheck environment configuration ──
# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any file containing real credentials.

# Google Gemini API key — server-side only. Never expose in browser bundle.
GEMINI_API_KEY=

# Gemini model identifier (e.g. gemini-2.5-flash)
GEMINI_MODEL=

# Extraction provider: "gemini" (direct, server-side) or "openrouter" (legacy rollback path)
EXTRACTION_PROVIDER=gemini

# ─ Nosana (decentralized GPU workload) — server-side only ──
# Nosana API key for workload submission. Never expose in browser bundle.
NOSANA_API_KEY=

# Nosana market address (Solana public key)
NOSANA_MARKET=

# Maximum USD spend ceiling for Nosana workloads (safety limit)
NOSANA_COST_CEILING_USD=10
