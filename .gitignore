# ── Local secrets — never commit ──
.env
.env.*
!.env.example

# ── Node ──
node_modules/
.npm-cache/

# ── Build output ──
dist/
build/
coverage/

# ── Logs ──
logs/
*.log

# ── OS / editor files ──
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ── Python virtual environments ──
.tts-venv/
.video-toolchain-venv/
__pycache__/
*.pyc

# ── Generated / local evidence containing secrets or personal data ──
app/public/nosana-risk-result.json
smoke-tests/nosana/results/nosana-risk-result.json

# ── Temporary files ──
*.tmp
*.temp
.cache/
:memory:.ses

# ── Output artifacts (captures, demo builds, personal paths) ──
output/
.recordings/

# ── Deck export: keep the build script, ignore rendered frames ──
.tmp-deck-export/rendered/
.tmp-deck-export/node_modules

# ── Pre-commit rollback backup snapshots ──
.rollback-*/

# ── IDE / tool local state ──
.cursor/
.workbuddy-ai/
.qoder/

# ── Presentation assets: deck files (*.key, *.pptx, *.pdf) are submission
# artifacts and are intentionally tracked. ──
# NOTE: Large presentation files (>100MB) must be gitignored for GitHub compatibility
Agentic AI Hackathon*.pptx
Agentic AI Hackathon*.key
Agentic AI Hackathon.pdf

# ── Post-hackathon cleanup — working scratch and build artifacts ──
a/
.qoder/specs/
deck/
submission/
smoke-tests/atlas/live-app-runs/
smoke-tests/nosana/results/evidence/
StitchCheck-Deck-*.pdf

# ── Large binary video artifacts — never commit these ──
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm
*.m4v
*.mpg
*.mpeg

# ── Video/audio project files ──
*.prproj
*.aep
*.fcpxml
*.davinci

# ── Large binary image formats (design source files) ──
*.bmp
*.tiff
*.psd
*.ai
*.eps

# ── Additional build output directories ──
out/
.next/
.nuxt/

# ── Large binary artifacts — never commit these (per repo hygiene spec) ──
# Large PDFs (decks, submissions, email exports)
*.pdf

# Large image assets (screenshots, exports)
*.png
*.jpg
*.jpeg
*.gif
*.svg

# Whitelist exceptions — tracked assets the submission needs.
# Blanket *.pdf / *.png / *.svg rules above would otherwise hide future
# additions of these files; already-tracked copies stay tracked either way.
!demo-evidence/**/*.png
!app/public/*.png
!app/public/*.jpg
!app/src/assets/*.png
!app/src/assets/*.jpg
!smoke-tests/extraction/fixtures/*.png
!smoke-tests/extraction/fixtures/*.svg

# Keep the final Alibaba x Atlas submission deck versioned.
!deck/
deck/*
!deck/StitchCheck-Alibaba-Atlas-Hackathon-2026-Updated.html
!deck/StitchCheck-Alibaba-Atlas-Hackathon-2026-Updated.pdf
!deck/export-updated-deck-pdf.mjs
