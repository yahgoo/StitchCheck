# ── Local secrets — never commit ──
.env
.env.*
!.env.example

# ── Node ──
node_modules/
.npm-cache/

# ── Build output ──
dist/
build/
coverage/

# ── Logs ──
logs/
*.log

# ── OS / editor files ──
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ── Python virtual environments ──
.tts-venv/
.video-toolchain-venv/
__pycache__/
*.pyc

# ── Generated / local evidence containing secrets or personal data ──
app/public/nosana-risk-result.json
smoke-tests/nosana/results/nosana-risk-result.json

# ── Temporary files ──
*.tmp
*.temp
.cache/
:memory:.ses

# ── Output artifacts (captures, demo builds, personal paths) ──
output/
.recordings/

# ── Deck export: keep the build script, ignore rendered frames ──
.tmp-deck-export/rendered/
.tmp-deck-export/node_modules

# ── Pre-commit rollback backup snapshots ──
.rollback-*/

# ── IDE / tool local state ──
.cursor/
.workbuddy-ai/
.qoder/*
!.qoder/specs/

# ── Presentation assets: deck files (*.key, *.pptx, *.pdf) are submission
# artifacts and are intentionally tracked. ──
