#!/bin/bash

# Pre-commit hook to reject files larger than 10MB
MAX_SIZE=10485760  # 10MB in bytes

# Get list of staged files (NUL-delimited to survive spaces in file names)
git diff --cached --name-only -z |
while IFS= read -r -d '' file; do
  if [ -f "$file" ]; then
    size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_SIZE" ]; then
      echo "ERROR: File '$file' is larger than 10MB ($size bytes). Refusing to commit."
      echo "Consider using Git LFS or storing large files externally."
      exit 1
    fi
  fi
done

exit $?
